<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YJCabin.Desktop.ViewModels"
             xmlns:views="using:YJCabin.Desktop.Views"
             xmlns:svc="using:YJCabin.Desktop.Services"
             x:Class="YJCabin.Desktop.Views.ArticlesPage"
             x:Name="PageRoot"
             x:DataType="vm:ArticlesViewModel"
             Focusable="True"
             KeyDown="OnPageKeyDown">
  <Panel>
    <DockPanel IsVisible="{Binding !ShowEditor}">
      <Border Classes="glass" DockPanel.Dock="Top" Margin="0,0,0,12">
        <Border Classes="card-head" BorderThickness="0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <Button Classes="primary compact" Content="新建" Command="{Binding NewItemCommand}" />
              <Button Classes="compact" Content="刷新" Command="{Binding ReloadCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="管理公开文章，点击卡片即可编辑。" />
          </DockPanel>
        </Border>
      </Border>
      <ScrollViewer>
        <Panel>
          <TextBlock Classes="muted"
                     IsVisible="{Binding !HasItems}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="还没有文章，点击新建开始。" />
          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="svc:ArticleSummary">
                <Button Classes="tile"
                        Command="{Binding #PageRoot.((vm:ArticlesViewModel)DataContext).OpenItemCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Classes="kicker" Text="{Binding Status, Converter={StaticResource StatusLabel}}" />
                    <TextBlock Classes="tile-title" Margin="0,8,0,0" Text="{Binding Title}" />
                    <TextBlock Classes="tile-summary" MaxHeight="54" Text="{Binding Summary}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </ScrollViewer>
    </DockPanel>

    <Grid RowDefinitions="Auto,Auto,Auto,*" IsVisible="{Binding ShowEditor}">
      <Border Padding="0,0,0,10" IsVisible="{Binding !IsImmersive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary compact" Content="发布" Command="{Binding PublishCommand}" />
            <Button Classes="compact" Content="保存草稿" Command="{Binding SaveCommand}" />
            <Button Classes="danger compact" Content="删除" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" />
            <Button Classes="compact" Content="返回" Command="{Binding CloseEditorCommand}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Classes="glass" Padding="16,14" Margin="0,0,0,12" IsVisible="{Binding !IsImmersive}">
        <Grid RowDefinitions="Auto,14,Auto,14,Auto">
          <StackPanel>
            <TextBlock Classes="label" Text="标题" />
            <TextBox Text="{Binding Title}" />
            <TextBlock Classes="muted" Margin="2,8,0,0" Text="{Binding SlugHint}" />
          </StackPanel>
          <StackPanel Grid.Row="2">
            <DockPanel>
              <Button DockPanel.Dock="Right"
                      Classes="compact"
                      Content="生成摘要"
                      Command="{Binding SummarizeCommand}" />
              <TextBlock Classes="label" VerticalAlignment="Center" Text="摘要" />
            </DockPanel>
            <TextBox AcceptsReturn="True"
                     Height="110"
                     TextWrapping="Wrap"
                     Text="{Binding Summary}" />
          </StackPanel>
          <StackPanel Grid.Row="4">
            <TextBlock Classes="label" Text="标签" />
            <TextBlock Classes="muted" Margin="0,4,0,8" TextWrapping="Wrap" Text="在设置里添加标签后，这里点选即可。" />
            <ItemsControl ItemsSource="{Binding TagChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TagChoice">
                  <ToggleButton Classes="tag-chip"
                                Margin="0,0,8,8"
                                IsChecked="{Binding IsSelected}"
                                Content="{Binding Name}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2"
              Classes="glass"
              Padding="12,10"
              Margin="0,0,0,12"
              IsVisible="{Binding IsImmersive}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary compact" Content="发布" Command="{Binding PublishCommand}" />
            <Button Classes="compact" Content="保存草稿" Command="{Binding SaveCommand}" />
            <Button Classes="compact" Content="退出沉浸" Command="{Binding ToggleImmersiveCommand}" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="kicker" Text="沉浸式编写" />
            <TextBlock Classes="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Row="3" ColumnDefinitions="*,14,*">
        <Border Classes="glass" Padding="16">
          <Grid RowDefinitions="Auto,*">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                <Button Classes="compact"
                        Content="{Binding ImmersiveButtonText}"
                        Command="{Binding ToggleImmersiveCommand}" />
                <Button Classes="compact"
                        Content="插入图片"
                        Click="OnInsertImageClick" />
              </StackPanel>
              <StackPanel>
                <TextBlock Classes="kicker" Text="Markdown" />
                <TextBlock Classes="muted" Margin="0,6,0,0" Text="可 Ctrl+V 粘贴截图。图片先放本地缓存，发布时才上传。" />
              </StackPanel>
            </DockPanel>
            <TextBox Grid.Row="1"
                     x:Name="MarkdownBox"
                     Classes="markdown"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalAlignment="Stretch"
                     Margin="0,10,0,0"
                     Text="{Binding Markdown}"
                     PastingFromClipboard="OnMarkdownPasting"
                     DragDrop.AllowDrop="True"
                     DragDrop.DragOver="OnMarkdownDragOver"
                     DragDrop.Drop="OnMarkdownDrop" />
          </Grid>
        </Border>

        <Border Grid.Column="2" Classes="glass" Padding="16">
          <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Classes="kicker" Text="预览" />
            <TextBlock Grid.Row="1"
                       Classes="title"
                       Margin="0,10,0,8"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !IsImmersive}"
                       Text="{Binding Title}" />
            <Panel Grid.Row="2">
              <TextBlock Classes="muted"
                         IsVisible="{Binding !HasMarkdown}"
                         Text="在左侧书写，这里会即时预览。" />
              <views:MarkdownPreview Markdown="{Binding PreviewMarkdown}"
                                     AssetPathRoot="{Binding MediaBaseUrl}"
                                     IsVisible="{Binding HasMarkdown}"
                                     SaveScrollValueWhenContentUpdated="True" />
            </Panel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Panel>
</UserControl>
