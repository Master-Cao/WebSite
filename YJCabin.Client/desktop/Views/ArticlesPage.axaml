<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:YJCabin.Desktop.ViewModels"
             xmlns:views="using:YJCabin.Desktop.Views"
             xmlns:svc="using:YJCabin.Desktop.Services"
             x:Class="YJCabin.Desktop.Views.ArticlesPage"
             x:Name="PageRoot"
             x:DataType="vm:ArticlesViewModel">
  <Panel>
    <DockPanel IsVisible="{Binding !ShowEditor}">
      <Border Classes="glass" DockPanel.Dock="Top" Margin="0,0,0,12">
        <Border Classes="card-head" BorderThickness="0">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
              <Button Classes="primary compact" Content="新建" Command="{Binding NewItemCommand}" />
              <Button Classes="compact" Content="刷新" Command="{Binding ReloadCommand}" />
            </StackPanel>
            <TextBlock Classes="muted" VerticalAlignment="Center" Text="{Binding Message}" TextWrapping="Wrap" />
          </DockPanel>
        </Border>
      </Border>
      <ScrollViewer>
        <Panel>
          <TextBlock Classes="muted"
                     IsVisible="{Binding !HasItems}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Text="还没有文章，点击新建开始。" />
          <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding HasItems}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="svc:ArticleSummary">
                <Button Classes="tile"
                        Command="{Binding #PageRoot.((vm:ArticlesViewModel)DataContext).OpenItemCommand}"
                        CommandParameter="{Binding}">
                  <StackPanel>
                    <TextBlock Classes="kicker" Text="{Binding Status, Converter={StaticResource StatusLabel}}" />
                    <TextBlock Classes="tile-title" Margin="0,8,0,0" Text="{Binding Title}" />
                    <TextBlock Classes="tile-summary" MaxHeight="54" Text="{Binding Summary}" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Panel>
      </ScrollViewer>
    </DockPanel>

    <Grid RowDefinitions="Auto,Auto,*" IsVisible="{Binding ShowEditor}">
      <Border Classes="glass" Padding="16,12" Margin="0,0,0,12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
            <Button Classes="primary compact" Content="发布" Command="{Binding PublishCommand}" />
            <Button Classes="compact" Content="保存草稿" Command="{Binding SaveCommand}" />
            <Button Classes="danger compact" Content="删除" Command="{Binding DeleteCommand}" IsEnabled="{Binding CanDelete}" />
            <Button Classes="compact" Content="返回" Command="{Binding CloseEditorCommand}" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Classes="kicker" Text="文章" />
            <TextBlock Classes="title" Text="{Binding EditorTitle}" />
            <TextBlock Classes="muted" Text="{Binding Message}" />
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Grid.Row="1" Classes="glass" Padding="16,14" Margin="0,0,0,12">
        <Grid ColumnDefinitions="2*,12,*" RowDefinitions="Auto,12,Auto">
          <StackPanel Grid.ColumnSpan="3">
            <TextBlock Classes="label" Text="标题" />
            <TextBox Text="{Binding Title}" />
            <TextBlock Classes="muted" Margin="2,8,0,0" Text="{Binding SlugHint}" />
          </StackPanel>
          <StackPanel Grid.Row="2">
            <TextBlock Classes="label" Text="摘要" />
            <TextBox AcceptsReturn="True" Height="56" Text="{Binding Summary}" />
          </StackPanel>
          <StackPanel Grid.Row="2" Grid.Column="2">
            <TextBlock Classes="label" Text="标签" />
            <TextBlock Classes="muted" Margin="0,0,0,8" TextWrapping="Wrap" Text="在设置里添加标签后，这里点选即可。" />
            <ItemsControl ItemsSource="{Binding TagChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TagChoice">
                  <ToggleButton Classes="tag-chip"
                                Margin="0,0,8,8"
                                IsChecked="{Binding IsSelected}"
                                Content="{Binding Name}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2" ColumnDefinitions="*,14,*">
        <Border Classes="glass" Padding="16">
          <Grid RowDefinitions="Auto,*">
            <TextBlock Classes="kicker" Text="Markdown" />
            <TextBox Grid.Row="1"
                     Classes="markdown"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalAlignment="Stretch"
                     Margin="0,10,0,0"
                     Text="{Binding Markdown}" />
          </Grid>
        </Border>

        <Border Grid.Column="2" Classes="glass" Padding="16">
          <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Classes="kicker" Text="预览" />
            <TextBlock Grid.Row="1"
                       Classes="title"
                       Margin="0,10,0,8"
                       TextWrapping="Wrap"
                       Text="{Binding Title}" />
            <Panel Grid.Row="2">
              <TextBlock Classes="muted"
                         IsVisible="{Binding !HasMarkdown}"
                         Text="在左侧书写，这里会即时预览。" />
              <views:MarkdownPreview Markdown="{Binding Markdown}"
                                     IsVisible="{Binding HasMarkdown}"
                                     SaveScrollValueWhenContentUpdated="True" />
            </Panel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Panel>
</UserControl>
