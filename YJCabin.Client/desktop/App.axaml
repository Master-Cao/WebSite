<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:YJCabin.Desktop.Converters"
             x:Class="YJCabin.Desktop.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <converters:StatusLabelConverter x:Key="StatusLabel" />
        <Color x:Key="VoidColor">#06101C</Color>
        <Color x:Key="InkColor">#E8F4FF</Color>
        <Color x:Key="MutedColor">#8BA3C4</Color>
        <Color x:Key="LineColor">#2EA0D2FF</Color>
        <Color x:Key="PanelColor">#C4102038</Color>
        <Color x:Key="FieldColor">#73040C18</Color>
        <Color x:Key="SystemAccentColor">#7ECFFF</Color>
        <Color x:Key="SystemAccentColorDark1">#4AA8E0</Color>
        <Color x:Key="SystemAccentColorLight1">#B8E7FF</Color>
        <SolidColorBrush x:Key="VoidBrush" Color="{StaticResource VoidColor}" />
        <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
        <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
        <SolidColorBrush x:Key="FieldBrush" Color="{StaticResource FieldColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource SystemAccentColor}" />
        <SolidColorBrush x:Key="AccentDimBrush" Color="#287ECFFF" />
        <LinearGradientBrush x:Key="GlassFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#38FFFFFF" Offset="0" />
            <GradientStop Color="#2216283C" Offset="0.42" />
            <GradientStop Color="#C414243C" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="TileFill" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#2EFFFFFF" Offset="0" />
            <GradientStop Color="#1A142838" Offset="1" />
        </LinearGradientBrush>
        <StreamGeometry x:Key="IconMailUnread">M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4M20,8L12,13L4,8V6L12,11L20,6V8Z</StreamGeometry>
        <StreamGeometry x:Key="IconMailRead">M4,8L12,13L20,8L12,3L4,8M22,8V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V8C2,7.27 2.4,6.63 3,6.28L12,0.64L21,6.28C21.6,6.63 22,7.27 22,8Z</StreamGeometry>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource VoidBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, sans-serif" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.kicker">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
        <Style Selector="TextBlock.danger">
            <Setter Property="Foreground" Value="#FF8B8B" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.glass">
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="BorderBrush" Value="#52A0D2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="BoxShadow" Value="0 16 42 0 #73000000" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#3EA0D2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox.markdown">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#3EA0D2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#2AFFFFFF" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#46A0D2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="#041018" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#B8E7FF" />
            <Setter Property="Foreground" Value="#041018" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.danger">
            <Setter Property="Foreground" Value="#FF8B8B" />
            <Setter Property="BorderBrush" Value="#66FF8B8B" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#1A7ECFFF" />
        </Style>
        <Style Selector="ProgressBar.overlay">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Height" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="#24FFFFFF" />
        </Style>
        <Style Selector="Border.card-head">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Button.compact">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
        </Style>
        <Style Selector="Button.avatar">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#24040C18" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Button.avatar:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
        </Style>
        <Style Selector="FlyoutPresenter">
            <Setter Property="Background" Value="{StaticResource GlassFill}" />
            <Setter Property="BorderBrush" Value="#52A0D2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style Selector="Button.tile">
            <Setter Property="Width" Value="260" />
            <Setter Property="MinHeight" Value="156" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource TileFill}" />
            <Setter Property="BorderBrush" Value="#46A0D2FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.tile /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.tile:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
        </Style>
        <Style Selector="TextBlock.tile-title">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.tile-summary">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style Selector="Border.setting-chip">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
            <Setter Property="BorderBrush" Value="#46A0D2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="10,4,6,4" />
        </Style>
        <Style Selector="Button.chip-remove">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#22040C18" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ToggleButton.tag-chip">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#22040C18" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="BorderBrush" Value="#3EA0D2FF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.tag-chip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="ToggleButton.tag-chip:checked">
            <Setter Property="Background" Value="{StaticResource AccentDimBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="ScrollViewer">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="10" />
            <Setter Property="Margin" Value="2,4" />
        </Style>
        <Style Selector="ScrollBar:horizontal">
            <Setter Property="Height" Value="10" />
            <Setter Property="Margin" Value="4,2" />
        </Style>
        <Style Selector="ScrollBar /template/ RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ScrollBar /template/ Border#Track">
            <Setter Property="Background" Value="#33040C18" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>
        <Style Selector="ScrollBar Thumb">
            <Setter Property="Background" Value="#8A7ECFFF" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="MinWidth" Value="28" />
        </Style>
        <Style Selector="ScrollBar Thumb:pointerover">
            <Setter Property="Background" Value="#B8E7FF" />
        </Style>
        <Style Selector="ScrollBar Thumb:pressed">
            <Setter Property="Background" Value="#7ECFFF" />
        </Style>
        <Style Selector="Border.md-code">
            <Setter Property="Margin" Value="0,18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#337ECFFF" />
            <Setter Property="BoxShadow" Value="inset 0 1 0 #14FFFFFF" />
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#C712243A" />
                    <GradientStop Offset="1" Color="#EB081220" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.md-code-bar">
            <Setter Property="Padding" Value="14,7,9,7" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#1F7ECFFF" />
            <Setter Property="Background" Value="#127ECFFF" />
        </Style>
        <Style Selector="TextBlock.md-code-lang">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="0.9" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.md-code-copy">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Padding" Value="11,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="#73040C18" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="BorderBrush" Value="#387ECFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.md-code-copy:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#73040C18" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="SelectableTextBlock.md-code-text">
            <Setter Property="Margin" Value="16,15,16,17" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, ui-monospace, monospace" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="LineHeight" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="Path.icon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style Selector="Border.status-icon">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="Border.status-icon.unread">
            <Setter Property="Background" Value="#337ECFFF" />
        </Style>
        <Style Selector="Border.status-icon.read">
            <Setter Property="Background" Value="#22040C18" />
            <Setter Property="BorderBrush" Value="#3EA0D2FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Application.Styles>
</Application>
